#!/bin/sh

# Runs database migrations against the version being deployed before its
# containers start serving traffic. AutoMigrate is additive-only (creates
# tables/columns, never drops), so it's safe to run on every boot, including
# rollbacks.
#
# These environment variables are available:
# KAMAL_RECORDED_AT
# KAMAL_PERFORMER
# KAMAL_VERSION
# KAMAL_HOSTS
# KAMAL_ROLES (if set)
# KAMAL_DESTINATION (if set)

echo "Running database migrations for version $KAMAL_VERSION..."
kamal app exec --version="$KAMAL_VERSION" --primary --skip-hooks './database migrate'

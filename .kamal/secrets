# Option 3: Read secrets via kamal secrets helpers
# These will handle logging in and fetching the secrets in as few calls as possible
# There are adapters for 1Password, LastPass + Bitwarden
#
# SECRETS=$(kamal secrets fetch --adapter 1password --account my --from InterventionTracker/env production/SERVER_WEB_PASSWORD production/SERVER_WEB_USER production/SERVER_WEB_IP)
OP_ENV_PATH="op://InterventionTracker/env/production"

KAMAL_REGISTRY_USERNAME=$(op read "$OP_ENV_PATH/KAMAL_REGISTRY_USERNAME")
KAMAL_REGISTRY_PASSWORD=$(op read "$OP_ENV_PATH/KAMAL_REGISTRY_PASSWORD")

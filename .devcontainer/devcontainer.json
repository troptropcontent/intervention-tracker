// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go-postgres
{
	"name": "Go & PostgreSQL",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/ruby": {},
		"ghcr.io/devcontainers/features/docker-in-docker:3": {
			"moby": false
		}
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"a-h.templ",
				"anthropic.claude-code",
				"bradlc.vscode-tailwindcss",
				"GitHub.vscode-pull-request-github",
				"golang.go",
				"tamasfe.even-better-toml"
			]
		}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		8080
	],
	"postCreateCommand": "op run --env-file='./.env' -- bash .devcontainer/scripts/post-create.sh",
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "go version",
	// Re-resolves .env secrets into ~/.env.local.sh on every container start
	// (including simple restarts, not just rebuilds), so every new shell
	// already has real secret values exported - no need to prefix commands
	// with `op run --env-file=./.env --`.
	"postStartCommand": "bash .devcontainer/scripts/resolve-env.sh"
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
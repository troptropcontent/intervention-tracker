package templates

import (
	"strconv"

	"github.com/labstack/echo/v4"
	"github.com/troptropcontent/qr_code_maintenance/internal/models"
)

func qrCodeStatusLabel(status models.QRCodeStatus) string {
	switch status {
	case models.QRCodeStatusAvailable:
		return "Disponible"
	case models.QRCodeStatusAssociated:
		return "Associé"
	case models.QRCodeStatusDamaged:
		return "Endommagé"
	case models.QRCodeStatusLost:
		return "Perdu"
	default:
		return string(status)
	}
}

func qrCodeStatusBadgeClass(status models.QRCodeStatus) string {
	switch status {
	case models.QRCodeStatusAvailable:
		return "badge badge-info"
	case models.QRCodeStatusAssociated:
		return "badge badge-success"
	case models.QRCodeStatusDamaged:
		return "badge badge-warning"
	case models.QRCodeStatusLost:
		return "badge badge-error"
	default:
		return "badge"
	}
}

templ AdminQRCodes(context echo.Context, pagination PaginationData, status string, search string, qrCodes []models.QRCode) {
	@MainLayout(MainLayoutConfig{Title: "Admin - QR Codes"}, context) {
		<div class="max-w-7xl mx-auto">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-3xl font-bold text-gray-900">QR Codes</h1>
				<a href="/admin/qr-codes/batches/new" class="btn btn-primary btn-sm">
					Générer des QR codes
				</a>
			</div>
			<!-- Filters -->
			<div class="mb-6">
				<form method="GET" action="/admin/qr-codes" class="flex gap-4">
					<input
						type="text"
						name="search"
						value={ search }
						placeholder="Rechercher par UUID..."
						class="input input-bordered flex-1"
						hx-get="/admin/qr-codes"
						hx-trigger="input changed delay:500ms, keyup[key=='Enter']"
						hx-select="#qr-codes"
						hx-target="#qr-codes"
					/>
					<select
						name="status"
						class="select select-bordered"
						hx-get="/admin/qr-codes"
						hx-trigger="change"
						hx-select="#qr-codes"
						hx-target="#qr-codes"
						hx-include="[name='search']"
					>
						<option value="" selected?={ status == "" }>Tous les statuts</option>
						for _, s := range models.QRCodeStatuses {
							<option value={ string(s) } selected?={ status == string(s) }>{ qrCodeStatusLabel(s) }</option>
						}
					</select>
				</form>
			</div>
			if len(qrCodes) == 0 {
				<div class="text-center py-12">
					<div class="text-gray-500 text-lg">Aucun QR code trouvé</div>
				</div>
			} else {
				<div id="qr-codes">
					<div class="bg-white shadow-sm rounded-lg overflow-hidden">
						<table class="min-w-full divide-y divide-gray-200">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">UUID</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Portail</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Généré le</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								for _, qrCode := range qrCodes {
									<tr class="hover:bg-gray-50">
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm font-mono text-gray-900">{ qrCode.UUID }</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<span class={ qrCodeStatusBadgeClass(qrCode.Status) }>{ qrCodeStatusLabel(qrCode.Status) }</span>
										</td>
										<td class="px-6 py-4 hidden md:table-cell">
											if qrCode.Portal != nil {
												<a href={ templ.URL("/admin/portals/" + strconv.Itoa(int(qrCode.Portal.ID))) } class="link link-primary text-sm">
													{ qrCode.Portal.Name }
												</a>
											} else {
												<span class="text-sm text-gray-400">-</span>
											}
										</td>
										<td class="px-6 py-4 hidden md:table-cell">
											<div class="text-sm text-gray-500">{ qrCode.GeneratedAt.Format("02/01/2006") }</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
											if qrCode.Status != models.QRCodeStatusAssociated {
												<div class="flex gap-2">
													if qrCode.Status != models.QRCodeStatusDamaged {
														<form method="POST" action={ templ.URL("/admin/qr-codes/" + qrCode.UUID + "/status") }>
															<input type="hidden" name="status" value="damaged"/>
															<button type="submit" class="link link-warning text-xs">Endommagé</button>
														</form>
													}
													if qrCode.Status != models.QRCodeStatusLost {
														<form method="POST" action={ templ.URL("/admin/qr-codes/" + qrCode.UUID + "/status") }>
															<input type="hidden" name="status" value="lost"/>
															<button type="submit" class="link link-error text-xs">Perdu</button>
														</form>
													}
													if qrCode.Status != models.QRCodeStatusAvailable {
														<form method="POST" action={ templ.URL("/admin/qr-codes/" + qrCode.UUID + "/status") }>
															<input type="hidden" name="status" value="available"/>
															<button type="submit" class="link link-info text-xs">Disponible</button>
														</form>
													}
												</div>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<!-- Pagination -->
					if pagination.TotalPages > 1 {
						@Pagination(&pagination)
					}
				</div>
			}
		</div>
	}
}

package templates

import (
	"github.com/troptropcontent/qr_code_maintenance/internal/models"
	"github.com/troptropcontent/qr_code_maintenance/internal/services/translation"
	"strconv"
)

templ Intervention(translator translation.TranslatorService, intervention *models.Intervention) {
	<div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
		<div class="flex justify-between items-start mb-3">
			<div class="flex-1">
				<div class="flex items-center gap-3 mb-2">
					<h3 class="text-lg font-semibold text-gray-900">
						Intervention du { intervention.Date.Format("02/01/2006") }
					</h3>
					<span class="text-sm text-gray-500">
						par { intervention.UserName }
					</span>
				</div>
				if intervention.Summary != nil && *intervention.Summary != "" {
					<p class="text-gray-600 text-sm mb-3 whitespace-pre-wrap">{ *intervention.Summary }</p>
				}
			</div>
			<div class="text-xs text-gray-400">
				#{ strconv.Itoa(int(intervention.ID)) }
			</div>
		</div>
		<div class="flex justify-between items-center mt-3 pt-3 border-t border-gray-100">
			<div class="text-xs text-gray-500">
				Créée le { intervention.CreatedAt.Format("02/01/2006 à 15:04") }
			</div>
		</div>
	</div>
}

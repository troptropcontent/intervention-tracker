package templates

import (
	"github.com/troptropcontent/qr_code_maintenance/internal/models"
	"github.com/labstack/echo/v4"
)

templ AdminSettings(user models.User, saved bool, errorMessage string, context echo.Context) {
	@MainLayout(MainLayoutConfig{Title: "Paramètres"}, context) {
		<div class="max-w-2xl mx-auto">
			<div class="mb-6">
				<h1 class="text-3xl font-bold text-gray-900">Paramètres</h1>
			</div>

			if saved {
				<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
					Paramètres enregistrés avec succès.
				</div>
			}

			if errorMessage != "" {
				<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
					{ errorMessage }
				</div>
			}

			<div class="bg-white shadow-sm rounded-lg p-6">
				<form method="POST" action="/admin/settings" class="space-y-6">
					<div>
						<h3 class="text-lg font-medium text-gray-900 mb-4">Compte</h3>
						<div>
							<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email de connexion</label>
							<input
								type="email"
								id="email"
								name="email"
								value={ user.Email }
								class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
								required
							/>
							<p class="text-xs text-gray-500 mt-1">Utilisé pour vous connecter. Ne change pas automatiquement l'email de notification.</p>
						</div>
					</div>

					<div class="pt-6 border-t border-gray-200">
						<h3 class="text-lg font-medium text-gray-900 mb-4">Notifications</h3>
						<div>
							<label for="notification_email" class="block text-sm font-medium text-gray-700 mb-1">Email de notification</label>
							<input
								type="email"
								id="notification_email"
								name="notification_email"
								value={ user.NotificationEmail }
								class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
								required
							/>
							<p class="text-xs text-gray-500 mt-1">Les rapports d'intervention seront envoyés à cette adresse.</p>
						</div>
					</div>

					<div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
						<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-medium">
							Enregistrer
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}

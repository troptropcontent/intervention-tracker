package templates

import (
	"strconv"

	"github.com/labstack/echo/v4"
	"github.com/troptropcontent/qr_code_maintenance/internal/models"
)

templ AdminQRCodeBatchShow(context echo.Context, batch models.QRCodeBatch) {
	@MainLayout(MainLayoutConfig{Title: "Lot de QR codes"}, context) {
		<div class="max-w-3xl mx-auto">
			<div class="mb-6">
				<a href="/admin/qr-codes" class="text-blue-600 hover:text-blue-800 text-sm mb-2 inline-block">
					← Retour aux QR codes
				</a>
				<h1 class="text-3xl font-bold text-gray-900">
					if batch.Label != nil && *batch.Label != "" {
						{ *batch.Label }
					} else {
						Lot #{ strconv.Itoa(int(batch.ID)) }
					}
				</h1>
				<p class="text-gray-500 mt-1">
					{ strconv.Itoa(batch.Count) } QR codes générés le { batch.CreatedAt.Format("02/01/2006 à 15:04") }
				</p>
			</div>
			<div class="bg-white shadow-sm rounded-lg p-6 mb-6">
				<a
					href={ templ.URL("/admin/qr-codes/batches/" + strconv.Itoa(int(batch.ID)) + "/pdf") }
					class="btn btn-primary"
				>
					Télécharger le PDF à imprimer
				</a>
			</div>
			<div class="bg-white shadow-sm rounded-lg overflow-hidden">
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">UUID</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						for _, qrCode := range batch.QRCodes {
							<tr>
								<td class="px-6 py-3 text-sm font-mono text-gray-900">{ qrCode.UUID }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

package templates

import "github.com/labstack/echo/v4"

templ AdminQRCodeBatchNew(context echo.Context) {
	@MainLayout(MainLayoutConfig{Title: "Générer des QR codes"}, context) {
		<div class="max-w-md mx-auto">
			<div class="mb-6">
				<a href="/admin/qr-codes" class="text-blue-600 hover:text-blue-800 text-sm mb-2 inline-block">
					← Retour aux QR codes
				</a>
				<h1 class="text-3xl font-bold text-gray-900">Générer des QR codes</h1>
			</div>
			<div class="bg-white shadow-sm rounded-lg p-6">
				<form method="POST" action="/admin/qr-codes/batches" class="space-y-4">
					<div>
						<label for="count" class="block text-sm font-medium text-gray-700 mb-1">Nombre de QR codes</label>
						<input
							type="number"
							id="count"
							name="count"
							min="1"
							max="500"
							value="50"
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
							required
						/>
					</div>
					<div>
						<label for="label" class="block text-sm font-medium text-gray-700 mb-1">Libellé (optionnel)</label>
						<input
							type="text"
							id="label"
							name="label"
							placeholder="ex: Lot janvier 2026"
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
						/>
					</div>
					<div class="flex justify-end space-x-4 pt-4 border-t border-gray-200">
						<a href="/admin/qr-codes" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-md font-medium">
							Annuler
						</a>
						<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-medium">
							Générer
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}

package templates

import (
	"github.com/labstack/echo/v4"
	"github.com/troptropcontent/qr_code_maintenance/internal/models"
	"github.com/troptropcontent/qr_code_maintenance/internal/services/translation"
)

func qrCodeScanUnassociatedDescriptionKey(status *models.QRCodeStatus) string {
	if status == nil {
		return "views.static.qr_code_scan_unassociated.description.unknown"
	}
	switch *status {
	case models.QRCodeStatusDamaged:
		return "views.static.qr_code_scan_unassociated.description.damaged"
	case models.QRCodeStatusLost:
		return "views.static.qr_code_scan_unassociated.description.lost"
	default:
		return "views.static.qr_code_scan_unassociated.description.available"
	}
}

templ QRCodeScanUnassociated(context echo.Context, translator translation.TranslatorService, status *models.QRCodeStatus) {
	@MainLayout(MainLayoutConfig{Title: translator.MustTranslate("views.static.qr_code_scan_unassociated.title")}, context) {
		<div class="max-w-md mx-auto text-center mt-8">
			<div class="flex justify-center mb-4">
				<div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center">
					<svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
					</svg>
				</div>
			</div>
			<h1 class="text-2xl font-bold text-gray-900 mb-3">
				{ translator.MustTranslate("views.static.qr_code_scan_unassociated.title") }
			</h1>
			<p class="text-gray-600 mb-6">
				{ translator.MustTranslate(qrCodeScanUnassociatedDescriptionKey(status)) }
			</p>
			<div class="mt-4">
				<a href="/" class="link link-primary">
					{ translator.MustTranslate("views.static.not_found.back_to_home") }
				</a>
			</div>
		</div>
	}
}
